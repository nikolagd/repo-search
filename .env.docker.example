# Docker Compose defaults.
# Copy to .env.docker and change secrets before sharing or deploying.

DB_NAME=repo_search
DB_USER=repo_search
DB_PASSWORD=repo_search_password
POSTGRES_HOST_PORT=5432

API_HOST_PORT=8010
FRONTEND_HOST_PORT=8080
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

API_TOKEN=replace_with_a_long_random_local_token
ADMIN_JWT_SECRET=replace_with_a_different_long_random_admin_jwt_secret
ADMIN_JWT_EXPIRY_MINUTES=120
ADMIN_JWT_ROTATION_INTERVAL_MINUTES=15
ADMIN_JWT_MAX_SESSION_MINUTES=720
ADMIN_COOKIE_SECURE=false
ADMIN_JOB_STATUS_HISTORY_MINUTES=60
RUN_DB_MIGRATIONS_ON_STARTUP=true
EMBEDDING_BATCH_SIZE=32
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN_DB_MIGRATIONS_ON_STARTUP=true

OAI_BASE_URL=https://rfos.fon.bg.ac.rs/oai/request
OAI_REPOSITORY_NAME=Default OAI repository
OAI_REFRESH_INTERVAL=1440
OAI_METADATA_PREFIX=auto

HF_HUB_OFFLINE=0
PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu130

LLM_PROVIDER=ollama
LLM_URL=http://ollama:11434/api/generate
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT=60

# Official Ollama image published by Ollama.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_HOST_PORT=11434
OLLAMA_KEEP_ALIVE=30m

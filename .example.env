# =========================
# Baza info
# =========================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_name
DB_USER=your_username
DB_PASSWORD=your_password_here


# =========================
# OAI-PMH info
# =========================

# OAI endpoint (bez query parametara)
OAI_BASE_URL=https://rfos.fon.bg.ac.rs/oai/request
OAI_REPOSITORY_NAME=Default OAI repository
OAI_REFRESH_INTERVAL=1440

# Metadata format (auto bira qdc -> dim -> mods -> oai_dc)
OAI_METADATA_PREFIX=auto

# =========================
# API / Frontend
# =========================

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_TOKEN=replace_with_a_long_random_local_token
API_PROXY_TARGET=http://127.0.0.1:8010
ADMIN_JWT_SECRET=replace_with_a_different_long_random_admin_jwt_secret
ADMIN_JWT_EXPIRY_MINUTES=120
HF_HUB_OFFLINE=1

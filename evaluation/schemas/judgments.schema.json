{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["judgments"],
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query_id", "publication_id", "relevance"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "publication_id": {"type": "string", "minLength": 1},
          "relevance": {"type": "integer", "enum": [0, 1, 2]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

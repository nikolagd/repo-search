# Copy to .env.mac and replace the two secrets before the final demo.
API_TOKEN=replace_with_a_long_random_local_token
ADMIN_JWT_SECRET=replace_with_a_different_long_random_admin_jwt_secret
ADMIN_COOKIE_SECURE=false

MICROSERVICE_GATEWAY_HOST_PORT=8090
MICROSERVICE_FRONTEND_HOST_PORT=8091

DB_NAME=repo_search
DB_USER=repo_search
DB_PASSWORD=repo_search_password
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=repo_search_replication_password

# ARM64 images must use portable PyTorch versions from requirements.txt.
PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cpu
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_MODEL_REVISION=3d7cfbdacd47fdda877c5cd8a79fbcc4f2a574f3
EMBEDDING_DEVICE=cpu
GPU_REQUIRED=false
EMBEDDING_BATCH_SIZE=8
HF_HUB_OFFLINE=0

# Native macOS Ollama uses Metal. A 4B model is appropriate for 16 GB RAM.
LLM_PROVIDER=ollama
LLM_URL=http://host.docker.internal:11434/api/generate
LLM_MODEL=gemma3:4b
LLM_TIMEOUT=180
LLM_WARMUP_ENABLED=0
OLLAMA_KEEP_ALIVE=10m

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3

OTEL_TRACING_ENABLED=false
APP_OBSERVABILITY_LOG_QUERY_TEXT=false
APP_OBSERVABILITY_LOW_SCORE_THRESHOLD=0.35

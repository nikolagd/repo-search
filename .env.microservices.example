API_TOKEN=replace_with_a_long_random_local_token
ADMIN_JWT_SECRET=replace_with_a_different_long_random_admin_jwt_secret
ADMIN_JWT_EXPIRY_MINUTES=120
ADMIN_JWT_ROTATION_INTERVAL_MINUTES=15
ADMIN_JWT_MAX_SESSION_MINUTES=720
ADMIN_COOKIE_SECURE=false

MICROSERVICE_GATEWAY_HOST_PORT=8090
MICROSERVICE_FRONTEND_HOST_PORT=8091
MICROSERVICE_OLLAMA_HOST_PORT=11435

DB_NAME=repo_search
DB_USER=repo_search
DB_PASSWORD=repo_search_password
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=repo_search_replication_password

WORKER_POLL_INTERVAL_SECONDS=5
EMBEDDING_BATCH_SIZE=32
HF_HUB_OFFLINE=0
PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu130
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

LLM_PROVIDER=ollama
LLM_URL=http://ollama:11434/api/generate
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT=60
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=30m

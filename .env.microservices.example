API_TOKEN=replace_with_a_long_random_local_token
ADMIN_JWT_SECRET=replace_with_a_different_long_random_admin_jwt_secret
ADMIN_JWT_EXPIRY_MINUTES=120
ADMIN_JWT_ROTATION_INTERVAL_MINUTES=15
ADMIN_JWT_MAX_SESSION_MINUTES=720
ADMIN_COOKIE_SECURE=false

MICROSERVICE_GATEWAY_HOST_PORT=8090
MICROSERVICE_FRONTEND_HOST_PORT=8091
MICROSERVICE_OLLAMA_HOST_PORT=11435
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
CADVISOR_HOST_PORT=8088

DB_NAME=repo_search
DB_USER=repo_search
DB_PASSWORD=repo_search_password
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=repo_search_replication_password

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3
EMBEDDING_BATCH_SIZE=32
HF_HUB_OFFLINE=0
PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu130
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

LLM_PROVIDER=ollama
LLM_URL=http://ollama:11434/api/generate
LLM_MODEL=gemma4:12b
LLM_TIMEOUT=180
LLM_WARMUP_ENABLED=1
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=30m

PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION=15d
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=repo-search
OTEL_DEPLOYMENT_ENVIRONMENT=local-docker
APP_OBSERVABILITY_LOG_QUERY_TEXT=false
APP_OBSERVABILITY_LOW_SCORE_THRESHOLD=0.35
